# Токен бота @EVAPress_bot от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Telegram ID администраторов (логистов) через запятую. Узнать свой ID: команда /myid в боте
ADMIN_IDS=111111111,222222222
# Часовой пояс
TZ_NAME=Europe/Moscow
# Дописывать текст «Проблема на адресе» в столбец «комментарии» при выгрузке Excel (1 - да, 0 - нет)
WRITE_PROBLEMS_TO_COMMENTS=1
# Сколько дней назад водителю показываются назначенные незавершённые маршруты
DRIVER_ROUTE_DAYS=2
# Папка для базы данных и Excel-файлов. На хостинге с Docker (BotHost) укажите
# постоянное хранилище, которое не очищается при пересборке, например /data
# DATA_DIR=/data
# Время плановых резервных копий (ЧЧ:ММ через запятую). Копии уходят в канал резервных копий,
# а если он не подключён — администраторам из ADMIN_IDS. Пусто — не присылать.
BACKUP_TIMES=09:00,21:00
# Автокопия: закреплённое сообщение с копией базы, обновляется после изменений данных.
# Если хостинг сотрёт базу, бот при запуске сам восстановит данные из неё.
# По умолчанию — личный чат с первым ID из ADMIN_IDS. Можно указать ID приватного канала, где бот — администратор:
# тогда и плановые копии, и закреплённая автокопия будут в этом канале.
# BACKUP_CHAT_ID=-100...
# Как часто (минут) обновлять автокопию, если были изменения
AUTOSAVE_MINUTES=5
# «Маршрут до точки»: ключ Яндекс Геокодера (developer.tech.yandex.ru → «JavaScript API и HTTP Геокодер»).
# Без ключа координаты адресов ищутся через бесплатный OpenStreetMap (качество по российским адресам ниже).
# YANDEX_GEOCODER_KEY=
